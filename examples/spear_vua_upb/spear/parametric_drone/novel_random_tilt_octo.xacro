  <joint name="arm_1_motor_to_rotor_joint" type="fixed"><parent link="arm_1_motor_link"/><child link="arm_1_rotor_link"/><origin xyz="0.000000 0.000000 0.016000" rpy="-0.288088 -0.345696 -0.569987"/></joint>

