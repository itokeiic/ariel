    <collision><geometry><cylinder radius="0.014000" length="0.020000"/></geometry></collision>
    <xacro:inertial_cylinder_z mass="0.060000" radius="0.014000" length="0.020000"/>
  </link>
  <joint name="arm_1_arm_to_motor_joint" type="fixed"><parent link="arm_1_arm_link"/><child link="arm_1_motor_link"/><origin xyz="0.160000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/></joint>

