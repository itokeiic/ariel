  <link name="arm_2_rotor_link">
    <visual><origin xyz="0 0 0" rpy="0.000000 0.000000 0.000000"/><geometry><cylinder radius="0.067712" length="0.002000"/></geometry><material name="mat_rotor_cw"/></visual>
    <collision><origin xyz="0 0 0" rpy="0.000000 0.000000 0.000000"/><geometry><cylinder radius="0.067712" length="0.002000"/></geometry></collision>
