<?xml version="1.0"?>
<robot name="asymmetric_5rotor_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="mat_core"><color rgba="0.15 0.15 0.18 1.0"/></material>
  <material name="mat_arm"><color rgba="0.22 0.22 0.24 1.0"/></material>
  <material name="mat_motor"><color rgba="0.70 0.70 0.72 1.0"/></material>
  <material name="mat_rotor_ccw"><color rgba="0.10 0.10 0.10 0.85"/></material>
  <material name="mat_rotor_cw"><color rgba="0.05 0.25 0.55 0.85"/></material>

  <xacro:macro name="inertial_box" params="mass x y z">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="${mass}"/><inertia ixx="${mass*(y*y + z*z)/12.0}" ixy="0.0" ixz="0.0" iyy="${mass*(x*x + z*z)/12.0}" iyz="0.0" izz="${mass*(x*x + y*y)/12.0}"/></inertial>
  </xacro:macro>
  <xacro:macro name="inertial_cylinder_z" params="mass radius length">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="${mass}"/><inertia ixx="${mass*(3*radius*radius + length*length)/12.0}" ixy="0.0" ixz="0.0" iyy="${mass*(3*radius*radius + length*length)/12.0}" iyz="0.0" izz="${0.5*mass*radius*radius}"/></inertial>
  </xacro:macro>

  <link name="base_link">
    <visual><geometry><cylinder radius="0.050000" length="0.010000"/></geometry><material name="mat_core"/></visual>
    <collision><geometry><cylinder radius="0.050000" length="0.010000"/></geometry></collision>
    <xacro:inertial_cylinder_z mass="0.400000" radius="0.050000" length="0.010000"/>
  </link>

  <link name="imu_link">
    <visual><origin xyz="0 0 0.012" rpy="0 0 0"/><geometry><box size="0.012 0.012 0.004"/></geometry><material name="mat_motor"/></visual>
    <collision><origin xyz="0 0 0.012" rpy="0 0 0"/><geometry><box size="0.012 0.012 0.004"/></geometry></collision>
    <xacro:inertial_box mass="0.005" x="0.012" y="0.012" z="0.004"/>
  </link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- arm_1: spin=ccw, propsize=2.0, pitch=0.045, blades=2, arm_rpy=(0.001071057620672472, -0.09469280606322728, 0.157147209736526), motor_xyz=(0.15268174974942633, 0.0, 0.019086168708569752), rotor_rpy=(0.058367192727464115, -0.148974060873412, -0.2961007441931634) -->
  <link name="arm_1_arm_link">
    <visual><origin xyz="0.076341 0 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.008000" length="0.152682"/></geometry><material name="mat_arm"/></visual>
    <collision><origin xyz="0.076341 0 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.008000" length="0.152682"/></geometry></collision>
    <xacro:inertial_cylinder_z mass="0.027483" radius="0.008000" length="0.152682"/>
  </link>
  <joint name="base_to_arm_1_arm_joint" type="fixed"><parent link="base_link"/><child link="arm_1_arm_link"/><origin xyz="0.000000 0.000000 -0.005627" rpy="0.001071 -0.094693 0.157147"/></joint>

  <link name="arm_1_motor_link">
    <visual><geometry><cylinder radius="0.014000" length="0.020000"/></geometry><material name="mat_motor"/></visual>
    <collision><geometry><cylinder radius="0.014000" length="0.020000"/></geometry></collision>
    <xacro:inertial_cylinder_z mass="0.060000" radius="0.014000" length="0.020000"/>
  </link>
  <joint name="arm_1_arm_to_motor_joint" type="fixed"><parent link="arm_1_arm_link"/><child link="arm_1_motor_link"/><origin xyz="0.152682 0.000000 0.019086" rpy="-0.048186 0.023982 0.017977"/></joint>

  <link name="arm_1_rotor_link">
    <visual><origin xyz="0 0 0" rpy="0.000000 0.000000 0.000000"/><geometry><cylinder radius="0.063839" length="0.002000"/></geometry><material name="mat_rotor_ccw"/></visual>
    <collision><origin xyz="0 0 0" rpy="0.000000 0.000000 0.000000"/><geometry><cylinder radius="0.063839" length="0.002000"/></geometry></collision>
    <xacro:inertial_cylinder_z mass="0.010000" radius="0.010000" length="0.006000"/>
  </link>
  <joint name="arm_1_motor_to_rotor_joint" type="fixed"><parent link="arm_1_motor_link"/><child link="arm_1_rotor_link"/><origin xyz="0.000000 0.000000 0.016000" rpy="0.058367 -0.148974 -0.296101"/></joint>

  <!-- arm_2: spin=cw, propsize=2.0, pitch=0.045, blades=2, arm_rpy=(-0.03194989669640162, -0.06890410003764369, 1.7280601722204667), motor_xyz=(0.2225237326649527, 0.0, 0.017354029275668495), rotor_rpy=(-0.1272057136557225, -0.09705002016145249, 0.18427696396462812) -->
