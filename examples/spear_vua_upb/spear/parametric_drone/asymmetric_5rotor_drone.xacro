  <joint name="base_to_arm_2_arm_joint" type="fixed"><parent link="base_link"/><child link="arm_2_arm_link"/><origin xyz="0.000000 0.000000 0.003963" rpy="-0.031950 -0.068904 1.728060"/></joint>

