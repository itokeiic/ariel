    <collision><origin xyz="0.068354 0 0" rpy="0 1.57079632679 0"/><geometry><cylinder radius="0.008000" length="0.136708"/></geometry></collision>
    <xacro:inertial_cylinder_z mass="0.024607" radius="0.008000" length="0.136708"/>
